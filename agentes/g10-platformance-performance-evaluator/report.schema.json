            },
            "summary": {
              "type": "string",
              "description": "Conclusión breve sobre esta dimensión."
            }
          },
          "required": [
            "status",
            "summary"
          ],
          "additionalProperties": false,
          "description": "Necesidades, hipótesis y evolución inferibles desde tickets."
        },
        "prioritiesAndScope": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "GOOD",
                "WATCH",
                "RISK",
                "INSUFFICIENT_DATA"
              ],
              "description": "Resultado basado en evidencia: favorable, a observar, riesgoso o con datos insuficientes."
            },
            "summary": {
              "type": "string",
              "description": "Conclusión breve sobre esta dimensión."
            }
          },
          "required": [
            "status",
            "summary"
          ],
          "additionalProperties": false,
          "description": "Prioridades, jerarquías y cambios de alcance observables."
        },
        "ticketFlow": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "GOOD",
                "WATCH",
                "RISK",
                "INSUFFICIENT_DATA"
              ],
              "description": "Resultado basado en evidencia: favorable, a observar, riesgoso o con datos insuficientes."
            },
            "summary": {
              "type": "string",
              "description": "Conclusión breve sobre esta dimensión."
            }
          },
          "required": [
            "status",
            "summary"
          ],
          "additionalProperties": false,
          "description": "Creación, avance, acumulación y cierre de tickets."
        },
        "themes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "evolution": {
                "type": "string",
                "description": "Evolución durante el historial disponible."
              }
            },
            "required": [
              "name",
              "evolution"
            ],
            "additionalProperties": false
          }
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Vacíos observables de producto o ideación."
        }
      },
      "required": [
        "ticketEvidenceAvailable",
        "assessment",
        "ideation",
        "prioritiesAndScope",
        "ticketFlow",
        "themes",
        "gaps"
      ],
      "additionalProperties": false
