{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "summary": {
      "type": "string",
      "description": "Síntesis holística del producto, proyecto, ingeniería y personas."
    },
    "overallAssessment": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "GOOD",
            "WATCH",
            "RISK",
            "INSUFFICIENT_DATA"
          ],
          "description": "Resultado basado en evidencia: favorable, a observar, riesgoso o con datos insuficientes."
        },
        "confidence": {
          "type": "string",
          "enum": [
            "HIGH",
            "MEDIUM",
            "LOW",
            "INSUFFICIENT"
          ],
          "description": "Confianza según la cantidad, calidad y cobertura de la evidencia."
        },
        "summary": {
          "type": "string",
          "description": "Conclusión neutral basada en la evidencia disponible."
        },
        "positiveSignals": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Señales favorables observables."
        },
        "concerns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Señales desfavorables o contradicciones observables."
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Restricciones que reducen el alcance o la confianza."
        },
        "score": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            {
              "type": "null"
            }
          ],
          "description": "80-100 GOOD, 50-79 WATCH, 0-49 RISK; null para INSUFFICIENT_DATA."
        }
      },
      "required": [
        "status",
        "confidence",
        "summary",
        "positiveSignals",
        "concerns",
        "limitations",
        "score"
      ],
      "additionalProperties": false
    },
