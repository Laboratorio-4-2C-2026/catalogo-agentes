              "confidence",
              "summary",
              "positiveSignals",
              "concerns",
              "limitations"
            ],
            "additionalProperties": false
          },
          "contributionSummary": {
            "type": "string",
            "description": "Contribución observable y su contexto."
          },
          "metrics": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string",
                  "description": "Nombre neutral de una métrica disponible."
                },
                "value": {
                  "type": "string",
