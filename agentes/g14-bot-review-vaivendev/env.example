# Credenciales para el bot reviewer vaivendev

# Google Gemini API Key (gratuita de Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=
# Modelo de Gemini (por defecto gemini-flash-latest; gemini-2.5-flash ya no existe)
GEMINI_MODEL=gemini-flash-latest

# GitHub Token (PAT con permisos sobre vaiven-app: read repo/contents, write pull-requests)
GH_TOKEN=

# Jira Cloud (para leer criterios de aceptación del ticket SCRUM-<n>)
JIRA_BASE_URL=https://vaiven-app.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=

# Repositorio destino por defecto
TARGET_REPO=vaiven-austral/vaiven-app

# OpenRouter (proveedor principal, modelos gratuitos)
OPENROUTER_API_KEY=
